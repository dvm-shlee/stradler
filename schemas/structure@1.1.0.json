{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure@1.1.0",
  "title": "stradler project structure",
  "description": "The file .stradler/structure.toml, as the JSON data model of its parsed content (adds user-defined roles and area grade to 1.0.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "areas"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_-]+@[0-9]+\\.[0-9]+\\.[0-9]+|sha256:[0-9a-f]{64})$",
      "description": "Schema reference of this file."
    },
    "roles": {
      "type": "object",
      "description": "User-defined roles, by name; each is based on one core role.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "base"
        ],
        "properties": {
          "base": {
            "enum": [
              "input",
              "output",
              "code",
              "recipe",
              "image",
              "record",
              "agent"
            ],
            "description": "Core role the engine treats areas of this role as."
          },
          "description": {
            "type": "string",
            "description": "What areas of this role are for."
          },
          "mutability": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "immutable",
                "sealed",
                "mutable"
              ]
            },
            "description": "Mutabilities areas of this role may use."
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "description": "Upper bound of the agent keys of an area of this role; each key defaults to false.",
            "properties": {
              "search": {
                "type": "boolean",
                "description": "Query the metadata layer."
              },
              "read": {
                "type": "boolean",
                "description": "Read file contents."
              },
              "write": {
                "type": "boolean",
                "description": "Create or change files."
              }
            }
          },
          "min_grade": {
            "enum": [
              "public",
              "work",
              "confidential",
              "private"
            ],
            "description": "Least strict grade an area of this role may have."
          }
        }
      }
    },
    "areas": {
      "type": "object",
      "minProperties": 1,
      "description": "The areas of the project, by name.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "mutability"
        ],
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "store"
                ]
              }
            ]
          },
          {
            "not": {
              "required": [
                "path",
                "store"
              ]
            }
          }
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "A core role (input, output, code, recipe, image, record, agent) or a name defined in roles."
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!\\.$)(?!\\.stradler(/|$))(?!.*(^|/)\\.\\.(/|$)).+$",
            "description": "Folder of the area, relative to the project root; never empty, absolute, containing .., the root itself or inside .stradler."
          },
          "store": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Store (defined in config.toml) where the area's content lives."
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Data handler that indexes the area."
          },
          "mutability": {
            "enum": [
              "immutable",
              "sealed",
              "mutable"
            ],
            "description": "Required; no default."
          },
          "deletable_after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Areas that must exist as sealed snapshots before this area may be deleted."
          },
          "manifest": {
            "type": "string",
            "pattern": "^[^/\\\\]+\\.json$",
            "description": "Manifest file name in the root folder of the area (.json only)."
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Store that is the true source of the area's content."
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "description": "Agent access; each key defaults to false.",
            "properties": {
              "search": {
                "type": "boolean",
                "description": "Query the metadata layer."
              },
              "read": {
                "type": "boolean",
                "description": "Read file contents."
              },
              "write": {
                "type": "boolean",
                "description": "Create or change files."
              }
            }
          },
          "grade": {
            "enum": [
              "public",
              "work",
              "confidential",
              "private"
            ],
            "description": "Widest audience the content may be disclosed to, from least to most strict; absent means private."
          }
        }
      }
    }
  }
}
